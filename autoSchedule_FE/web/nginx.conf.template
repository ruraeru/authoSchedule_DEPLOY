# nginx 이미지가 시작할 때 ${BACKEND_URL}만 환경변수로 채운다($uri 같은 nginx 변수는 그대로 둔다)

# 앞단 HTTPS 프록시(Caddy 등)가 준 원래 프로토콜을 백엔드에 그대로 넘긴다. 없으면 이 nginx의 프로토콜.
# 백엔드가 요청을 https로 봐야 브라우저 Origin(https://...)과 같은 출처로 판정해 CORS 403을 내지 않는다
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # AI 근무표 생성이 3분 넘게 걸린다
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 해시가 붙은 빌드 파일은 오래 캐시, index.html은 매번 새로
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 새로고침·직접 접속(/schedules/3 등)을 앱으로
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
