# Copy to .env and fill in. Never commit .env.
# MySQL root (admin only, the app does not use it)
DB_ROOT_PASSWORD=change-me-root
# App DB user "autoschedule"
DB_PASSWORD=change-me
# 32+ bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# AI schedule generation: ollama (default) or gemini
AI_PROVIDER=ollama
# Ollama-compatible server (/api/chat) and its Bearer token
LLM_BASE_URL=https://ai.ruraeru.xyz
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
# Only used when AI_PROVIDER=gemini
GEMINI_API_KEY=
# true when served over HTTPS
COOKIE_SECURE=false
# Frontend origins if served from another origin, comma separated
CORS_ALLOWED_ORIGINS=
APP_PORT=8082
